# ─── OTOVISION OBRA — Variáveis de Ambiente ──────────────────────────────────
# Copie este arquivo para `.env` e preencha com suas credenciais reais.
# NUNCA commite o arquivo `.env` — ele está no .gitignore.

# ─── Supabase ─────────────────────────────────────────────────────────────────
# Encontre em: Supabase Dashboard → Settings → API

VITE_SUPABASE_URL=https://SEU_PROJECT_ID.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# ID do projeto (sem o domínio completo) — usado internamente
VITE_SUPABASE_PROJECT_ID=SEU_PROJECT_ID

# ─── IMPORTANTE: Rotação de chaves ───────────────────────────────────────────
# Se a VITE_SUPABASE_PUBLISHABLE_KEY foi commitada acidentalmente em algum
# momento, regenere-a em: Supabase → Settings → API → Regenerate anon key
# A chave anon é pública por design, mas deve ser rotacionada após exposição
# em repositórios públicos ou compartilhados.
